+using System;
+using System.Diagnostics;
+
+namespace Demo;
+
+public class BackupTool
+{
+    public void Run(string directory)
+    {
+        var process = Process.Start("/bin/sh", "-c \"tar -czf backup.tar.gz " + directory + "\"");
+        process?.WaitForExit();
+    }
+}
