+using System;
+
+namespace Demo;
+
+public class ShippingCalculator
+{
+    public decimal Calculate(decimal weight, int zone, bool express, bool insured)
+    {
+        if (weight > 0)
+        {
+            if (zone > 0)
+            {
+                if (express)
+                {
+                    if (insured)
+                    {
+                        return weight * 4.75m + 12.50m + 3.99m;
+                    }
+
+                    return weight * 4.75m + 12.50m;
+                }
+
+                if (insured)
+                {
+                    return weight * 2.15m + 3.99m;
+                }
+
+                return weight * 2.15m;
+            }
+        }
+
+        return 0m;
+    }
+}
