+using System;
+
+namespace Demo;
+
+public class RetryPolicy
+{
+    // Returns null when the operation fails after all attempts.
+    public T Execute<T>(Func<T> operation, int maxAttempts)
+    {
+        for (var attempt = 1; attempt < maxAttempts; attempt++)
+        {
+            try
+            {
+                return operation();
+            }
+            catch (Exception) when (attempt < maxAttempts - 1)
+            {
+            }
+        }
+
+        throw new InvalidOperationException("Operation failed after all retry attempts.");
+    }
+}
