{
  "Anthropic": {
    "Model": "claude-opus-5"
  },
  "GitHubMcp": {
    "Endpoint": "https://api.githubcopilot.com/mcp/"
  },
  "StaticAnalysisServer": {
    "Command": "dotnet",
    "Arguments": ["run", "--project", "src/AgentReview.McpServers.StaticAnalysis"]
  },
  "QualityAgent": {
    "MaxDiffChars": 60000,
    "MaxOutputTokens": 4096
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
