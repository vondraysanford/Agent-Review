{
  "Urls": "http://localhost:5100",
  "Anthropic": {
    "Model": "claude-opus-5"
  },
  "GitHubMcp": {
    "Endpoint": "https://api.githubcopilot.com/mcp/"
  },
  "StaticAnalysisServer": {
    "Command": "dotnet",
    "Arguments": [
      "../AgentReview.McpServers.StaticAnalysis/bin/Debug/net10.0/AgentReview.McpServers.StaticAnalysis.dll"
    ]
  },
  "QualityAgent": {
    "MaxDiffChars": 60000,
    "MaxOutputTokens": 4096,
    "MaxContextChars": 40000
  },
  "SecurityAgent": {
    "MaxDiffChars": 60000,
    "MaxOutputTokens": 4096,
    "MaxContextChars": 40000,
    "Ruleset": "p/csharp"
  },
  "DocsAgent": {
    "MaxDiffChars": 60000,
    "MaxOutputTokens": 4096,
    "MaxContextChars": 40000
  },
  "Synthesis": {
    "UseArbiter": true,
    "MaxOutputTokens": 1024
  },
  "Telemetry": {
    "Enabled": false
  },
  "Pricing": {
    "InputPerMillionTokens": 5.0,
    "OutputPerMillionTokens": 25.0
  },
  "Budget": {
    "MaxPerReviewUsd": 1.5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
